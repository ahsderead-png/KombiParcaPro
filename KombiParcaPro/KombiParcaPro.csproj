<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>KombiParcaPro</AssemblyName>
    <RootNamespace>KombiParcaPro</RootNamespace>
    <Version>3.0.0</Version>
    <ApplicationIcon>Assets\KombiParcaPro.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.12" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\catalog-v2-part*.json" />
    <EmbeddedResource Include="Assets\catalog-industrial-*.json" />
    <Content Include="Assets\3D-Teknik-Servis-Logo.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><Link>Assets\3D-Teknik-Servis-Logo.png</Link></Content>
    <Content Include="Assets\KombiParcaPro.ico"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><Link>Assets\KombiParcaPro.ico</Link></Content>
  </ItemGroup>
</Project>
